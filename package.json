{
  "name": "ReceiptScannerApp",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "npx react-native run-android",
    "android:release": "npx react-native run-android --mode=release",
    "ios": "npx react-native run-ios",
    "ios:release": "npx react-native run-ios --mode=Release",
    "lint": "eslint .",
    "start": "npx react-native start --reset-cache",
    "test": "jest",
    "apk:debug": "cd android && ./gradlew assembleDebug && cd ..",
    "apk:release": "cd android && ./gradlew assembleRelease && cd .."
  },
  "dependencies": {
    "@react-native-firebase/app": "^26.3.2",
    "@react-native-firebase/crashlytics": "^26.3.2",
    "@react-native/new-app-screen": "0.87.0",
    "@react-navigation/bottom-tabs": "^7.18.18",
    "@react-navigation/native": "^7.3.18",
    "@react-navigation/native-stack": "^7.18.10",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-config": "^1.7.2",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.19.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  },
  "codegenConfig": {
    "name": "ReceiptScannerSpecs",
    "type": "modules",
    "jsSrcsDir": "specs",
    "android": {
      "javaPackageName": "com.silverj0805.receiptscannerapp"
    },
    "ios": {
      "modules": {
        "ReceiptScanner": {
          "className": "ReceiptScannerModule"
        }
      }
    }
  }
}
