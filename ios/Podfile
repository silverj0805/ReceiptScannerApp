# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

# react-native-firebase가 기본으로 쓰는 SPM(Swift Package Manager) 기반 Firebase 해석은
# static 링키지(이 프로젝트의 기본값, use_frameworks! 미사용)와 함께 쓰면 중복 심볼 링크
# 에러가 남 — pod install이 직접 안내해준 두 가지 해결책 중, 프로젝트 전체를 동적 프레임워크로
# 바꾸는 대신(더 큰 구조 변경) 이쪽(SPM 비활성화, 기존 CocoaPods 방식으로 되돌림)을 선택.
$RNFirebaseDisableSPM = true

# Firebase의 일부 Swift 팟(FirebaseCoreInternal, FirebaseCrashlytics 등)이 module map이
# 없는 ObjC 팟(GoogleUtilities 등)에 의존하는데, static 라이브러리로 빌드할 땐 그 경우
# CocoaPods가 이 옵션을 켜라고 직접 안내함 — Swift에서 import 가능하도록 module map을 생성.
use_modular_headers!

target 'ReceiptScannerApp' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # react-native-config: Xcode 빌드 설정(Debug/Release)에 따라 서로 다른 .env 파일을
    # 읽도록 매핑. react-native-config 팟 자체의 빌드 타겟에 ENVFILE을 설정해야
    # 그 팟의 script_phase(GeneratedDotEnv.m 생성)가 올바른 파일을 읽는다.
    envfiles = {
      'Debug' => './env/.env.development',
      'Release' => './env/.env.production',
    }
    installer.pods_project.targets.each do |target|
      next unless target.name == 'react-native-config'

      target.build_configurations.each do |config|
        config.build_settings['ENVFILE'] = envfiles[config.name]
      end
    end
  end
end
